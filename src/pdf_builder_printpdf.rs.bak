use crate::parser::TexElement;
use crate::math_formatter::MathFormatter;
use printpdf::*;
use std::fs::File;
use std::io::BufWriter;
use std::path::Path;

pub struct PdfBuilder {
    title: Option<String>,
    author: Option<String>,
    date: Option<String>,
}

impl PdfBuilder {
    pub fn new() -> Self {
        Self {
            title: None,
            author: None,
            date: None,
        }
    }

    pub fn build(&mut self, elements: Vec<TexElement>, output_path: &Path) -> Result<(), String> {
        let (doc, page1, layer1) = PdfDocument::new(
            self.title.as_deref().unwrap_or("Document"),
            Mm(210.0),
            Mm(297.0),
            "Layer 1",
        );

        let mut current_page = doc.get_page(page1);
        let mut current_layer = current_page.get_layer(layer1);

        // Load DejaVu Sans font which supports Unicode mathematical symbols
        let font_path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("fonts/DejaVuSans.ttf");
        let font_data = std::fs::read(&font_path).map_err(|e| format!("Failed to load font: {}", e))?;
        let font = doc.add_external_font(std::io::Cursor::new(font_data)).map_err(|e| e.to_string())?;
        let font_bold = font.clone(); // Use same font for now (DejaVu Sans doesn't have separate bold in this setup)

        let mut y_position = 270.0;
        let left_margin = 20.0;
        let _right_margin = 190.0;
        let line_height = 6.0;

        if self.title.is_some() || self.author.is_some() {
            if let Some(title) = &self.title {
                current_layer.use_text(title, 24.0, Mm(left_margin), Mm(y_position), &font_bold);
                y_position -= 10.0;
            }

            if let Some(author) = &self.author {
                current_layer.use_text(author, 12.0, Mm(left_margin), Mm(y_position), &font);
                y_position -= 6.0;
            }

            if let Some(date) = &self.date {
                let date_text = if date == "\\today" {
                    chrono::Local::now().format("%B %d, %Y").to_string()
                } else {
                    date.clone()
                };
                current_layer.use_text(&date_text, 10.0, Mm(left_margin), Mm(y_position), &font);
                y_position -= 8.0;
            }

            y_position -= 5.0;
        }

        for element in elements {
            if y_position < 30.0 {
                let (new_page_idx, new_layer_idx) = doc.add_page(Mm(210.0), Mm(297.0), "Layer 1");
                current_page = doc.get_page(new_page_idx);
                current_layer = current_page.get_layer(new_layer_idx);
                y_position = 270.0;
            }

            match element {
                TexElement::Command { name, args } => {
                    match name.as_str() {
                        "title" => self.title = args.first().cloned(),
                        "author" => self.author = args.first().cloned(),
                        "date" => self.date = args.first().cloned(),
                        "maketitle" => {},
                        _ => {}
                    }
                }
                TexElement::Section { level, title } => {
                    y_position -= 3.0;
                    let font_size = if level == 1 { 18.0 } else { 14.0 };
                    current_layer.use_text(&title, font_size, Mm(left_margin), Mm(y_position), &font_bold);
                    y_position -= line_height + 2.0;
                }
                TexElement::Text(text) => {
                    let formatted_text = self.format_inline_math(&text);
                    let wrapped_lines = self.wrap_text(&formatted_text, 80);
                    for line in wrapped_lines {
                        if y_position < 30.0 {
                            let (new_page_idx, new_layer_idx) = doc.add_page(Mm(210.0), Mm(297.0), "Layer 1");
                            current_page = doc.get_page(new_page_idx);
                            current_layer = current_page.get_layer(new_layer_idx);
                            y_position = 270.0;
                        }
                        current_layer.use_text(&line, 11.0, Mm(left_margin), Mm(y_position), &font);
                        y_position -= line_height;
                    }
                }
                TexElement::Paragraph => {
                    y_position -= line_height;
                }
                TexElement::MathInline(math) => {
                    let formatted = MathFormatter::format(&math);
                    current_layer.use_text(&formatted, 11.0, Mm(left_margin), Mm(y_position), &font);
                    y_position -= line_height;
                }
                TexElement::MathDisplay(math) => {
                    if y_position < 30.0 {
                        let (new_page_idx, new_layer_idx) = doc.add_page(Mm(210.0), Mm(297.0), "Layer 1");
                        current_page = doc.get_page(new_page_idx);
                        current_layer = current_page.get_layer(new_layer_idx);
                        y_position = 270.0;
                    }
                    
                    y_position -= 3.0;
                    let formatted = MathFormatter::format(&math);
                    
                    current_layer.use_text(&formatted, 13.0, Mm(left_margin + 20.0), Mm(y_position), &font);
                    y_position -= line_height + 4.0;
                }
                TexElement::ItemList { ordered, items } => {
                    for (idx, item) in items.iter().enumerate() {
                        if y_position < 30.0 {
                            let (new_page_idx, new_layer_idx) = doc.add_page(Mm(210.0), Mm(297.0), "Layer 1");
                            current_page = doc.get_page(new_page_idx);
                            current_layer = current_page.get_layer(new_layer_idx);
                            y_position = 270.0;
                        }

                        let bullet = if ordered {
                            format!("{}.", idx + 1)
                        } else {
                            "•".to_string()
                        };

                        current_layer.use_text(&bullet, 11.0, Mm(left_margin + 5.0), Mm(y_position), &font);

                        let mut item_text = String::new();
                        for elem in item {
                            if let TexElement::Text(text) = elem {
                                item_text.push_str(text);
                                item_text.push(' ');
                            }
                        }

                        let wrapped_lines = self.wrap_text(&item_text.trim(), 75);
                        for (line_idx, line) in wrapped_lines.iter().enumerate() {
                            let x_offset = if line_idx == 0 { 10.0 } else { 15.0 };
                            current_layer.use_text(line, 11.0, Mm(left_margin + x_offset), Mm(y_position), &font);
                            y_position -= line_height;
                            
                            if y_position < 30.0 {
                                let (new_page_idx, new_layer_idx) = doc.add_page(Mm(210.0), Mm(297.0), "Layer 1");
                                current_page = doc.get_page(new_page_idx);
                                current_layer = current_page.get_layer(new_layer_idx);
                                y_position = 270.0;
                            }
                        }
                    }
                    y_position -= 2.0;
                }
                TexElement::Environment { .. } => {}
            }
        }

        doc.save(&mut BufWriter::new(File::create(output_path).map_err(|e| e.to_string())?))
            .map_err(|e| e.to_string())?;

        Ok(())
    }

    fn format_inline_math(&self, text: &str) -> String {
        let mut result = String::new();
        let mut chars = text.chars().peekable();
        let mut in_math = false;
        let mut math_buffer = String::new();
        
        while let Some(ch) = chars.next() {
            if ch == '$' {
                if in_math {
                    let formatted = MathFormatter::format(&math_buffer);
                    result.push_str(&formatted);
                    math_buffer.clear();
                    in_math = false;
                } else {
                    in_math = true;
                }
            } else if in_math {
                math_buffer.push(ch);
            } else {
                result.push(ch);
            }
        }
        
        if !math_buffer.is_empty() {
            result.push_str(&math_buffer);
        }
        
        result
    }

    fn wrap_text(&self, text: &str, max_chars: usize) -> Vec<String> {
        let mut lines = Vec::new();
        let mut current_line = String::new();
        
        for word in text.split_whitespace() {
            if current_line.len() + word.len() + 1 > max_chars {
                if !current_line.is_empty() {
                    lines.push(current_line.clone());
                    current_line.clear();
                }
            }
            
            if !current_line.is_empty() {
                current_line.push(' ');
            }
            current_line.push_str(word);
        }
        
        if !current_line.is_empty() {
            lines.push(current_line);
        }
        
        if lines.is_empty() {
            lines.push(String::new());
        }
        
        lines
    }
}

impl Default for PdfBuilder {
    fn default() -> Self {
        Self::new()
    }
}
